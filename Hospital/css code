
html {
  scroll-behavior: smooth;
}
body {
  font-family: 'DM Sans', sans-serif;
  color: darkgoldenrod;
  background: white;
  overflow-x: hidden;
}
h1, h2, h3, h4 {
  font-family: 'Playfair Display', serif;
}
a {
  text-decoration: none;
}

/* ===================== NAVBAR ===================== */
.navbar{
  background: green;
  padding: 0 30px;
  height: 66px;
  display: flex;
  align-items: center;
  position: sticky;
  top: 0;
  box-shadow: 0 2px 16px rgba(0,0,0,0.18);
}
.navbar-text {
  color: white;
  font-family: 'Playfair Display', serif;
  font-size: 1.25rem;
  font-weight: 700;
}
.navbar-text i {
  margin-right: 8px;
  color: #a8e6c8;
}

/* Desktop nav links */
.navlinks {
  display: flex;
  align-items: center;
  gap: 4px;
  margin-left: auto;
  list-style: none;
  padding: 0;
}
.navlinks a {
  color: rgba(255,255,255,0.88);
  font-size: 0.9rem;
  font-weight: 500;
  padding: 8px 12px;
  border-radius: 8px;
  transition: background 0.2s, color 0.2s;
  white-space: nowrap;
}
.navlinks a:hover {
  background: rgba(255,255,255,0.15);
  color: white;
}
.navlinks .btn-book {
  background: var(--accent);
  color: #1a1a1a !important;
  border-radius: 22px;
  padding: 8px 20px;
  font-weight: 700;
}
.navlinks .btn-book:hover {
  background: #e09510;
}

/* Hamburger button */
.mobile-btn {
  display: none;
  background: none;
  border: none;
  color: white;
  font-size: 1.5rem;
  margin-left: auto;
  cursor: pointer;
  padding: 4px 8px;
}

/* Mobile nav drawer */
.mobile-nav {
  display: none;
  flex-direction: column;
  background: var(--green);
  border-top: 1px solid rgba(255,255,255,0.15);
}
.mobile-nav.open {
  display: flex;
}
.mobile-nav a {
  color: rgba(255,255,255,0.9);
  padding: 13px 26px;
  font-size: 0.97rem;
  font-weight: 500;
  border-bottom: 1px solid rgba(255,255,255,0.08);
  transition: background 0.2s;
}
.mobile-nav a:hover {
  background: rgba(255,255,255,0.10);
}
.mobile-nav .m-book {
  color: var(--accent) !important;
  font-weight: 700;
}



/* ===================== HERO ===================== */
.hero {
  position: relative;
  height: 100vh;
  min-height: 520px;
  overflow: hidden;
}
.hero-bg {
  position: absolute;
  inset: 0;
  background-size: cover;
  background-position: center;
  animation: heroBg 18s ease-in-out infinite;
}
@keyframes heroBg {
  0%,100% {
    background-image: url('https://images.unsplash.com/photo-1586773860418-d37222d8fce3?w=1400');
  }
  33% {
    background-image: url('https://images.unsplash.com/photo-1504439468489-c8920d796a29?w=1400');
  }
  66% {
    background-image: url('https://images.unsplash.com/photo-1519494026892-80bbd2d6fd0d?w=1400');
  }
}
.hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    100deg,
    rgba(0,0,0,0.72) 45%,
    rgba(0,0,0,0.25) 100%
  );
}
.hero-content {
  position: relative;
  z-index: 2;
  height: 100%;
  display: flex;
  align-items: center;
  padding: 0 6vw 100px;
}
.hero-left {
  max-width: 560px;
}
.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: rgba(255,255,255,0.12);
  border: 1px solid rgba(255,255,255,0.25);
  color: white;
  padding: 6px 16px;
  border-radius: 20px;
  font-size: 0.82rem;
  font-weight: 600;
  letter-spacing: 0.5px;
  margin-bottom: 20px;
  backdrop-filter: blur(6px);
}
.hero-badge i {
  color: var(--accent);
}
.hero-left h1 {
  font-size: clamp(2.1rem, 5vw, 3.8rem);
  color: white;
  line-height: 1.15;
  margin-bottom: 18px;
}
.hero-left h1 span {
  color: #a8e6c8;
}
.hero-left p {
  color: rgba(255,255,255,0.82);
  font-size: clamp(0.95rem, 1.5vw, 1.08rem);
  line-height: 1.75;
  margin-bottom: 32px;
}
.hero-buttons {
  display: flex;
  gap: 14px;
  flex-wrap: wrap;
}

/* Hero buttons */
.btn-hero-primary {
  background: var(--green-light);
  color: white;
  padding: 13px 28px;
  border-radius: 30px;
  font-weight: 600;
  font-size: 0.96rem;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  transition: background 0.25s, transform 0.2s, box-shadow 0.2s;
}
.btn-hero-primary:hover {
  background: var(--green);
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(13,110,79,0.38);
  color: white;
}
.btn-hero-outline {
  background: transparent;
  color: white;
  border: 2px solid rgba(255,255,255,0.55);
  padding: 11px 26px;
  border-radius: 30px;
  font-weight: 600;
  font-size: 0.96rem;
  transition: border-color 0.2s, background 0.2s, transform 0.2s;
}
.btn-hero-outline:hover {
  border-color: white;
  background: rgba(255,255,255,0.10);
  transform: translateY(-2px);
  color: white;
}

/* Stats bar */
.stats-bar {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 3;
  background: rgba(255,255,255,0.97);
  backdrop-filter: blur(12px);
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
}
.stat-item {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 18px 36px;
  border-right: 1px solid #e5e7eb;
  flex: 1 1 auto;
  justify-content: center;
}
.stat-item:last-child {
  border-right: none;
}
.stat-icon {
  font-size: 1.5rem;
  color: var(--green);
}
.stat-num {
  font-family: 'Playfair Display', serif;
  font-size: 1.45rem;
  font-weight: 700;
  color: var(--blue);
  line-height: 1;
}
.stat-lbl {
  font-size: 0.77rem;
  color: var(--text-soft);
  font-weight: 500;
}

/* ===================== SHARED SECTION LAYOUT ===================== */
.section-wrap {
  padding: 90px 0;
}
.section-tag {
  display: inline-block;
  background: var(--green-pale);
  color: var(--green);
  font-size: 0.76rem;
  font-weight: 700;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  padding: 5px 16px;
  border-radius: 20px;
  margin-bottom: 12px;
}
.section-title {
  font-size: clamp(1.6rem, 2.8vw, 2.4rem);
  color: var(--blue);
  margin-bottom: 12px;
}
.section-sub {
  color: var(--text-soft);
  font-size: 0.97rem;
  max-width: 560px;
  line-height: 1.75;
}

/* Shared solid button */
.btn-primary-solid {
  background: var(--green);
  color: white;
  border: none;
  padding: 13px 30px;
  border-radius: 30px;
  font-size: 0.96rem;
  font-weight: 600;
  font-family: 'DM Sans', sans-serif;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  transition: background 0.2s, transform 0.2s, box-shadow 0.2s;
}
.btn-primary-solid:hover {
  background: var(--green-light);
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(13,110,79,0.30);
  color: white;
}

/* ===================== HOME / INTRO ===================== */
.home-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 44px;
  align-items: center;
}
.home-text .tagline {
  font-size: 0.97rem;
  color: var(--green);
  font-weight: 600;
  margin-bottom: 12px;
}
.home-text .desc {
  color: var(--text-soft);
  line-height: 1.78;
  margin-bottom: 24px;
}
.why-card-home {
  background: white;
  border-radius: var(--radius);
  padding: 32px;
  box-shadow: var(--shadow);
  border-left: 5px solid var(--green);
}
.why-card-home h3 {
  color: var(--green);
  margin-bottom: 18px;
  font-size: 1.2rem;
}
.why-card-home ul {
  list-style: none;
  padding: 0;
}
.why-card-home li {
  padding: 9px 0;
  color: var(--text);
  font-size: 0.95rem;
  border-bottom: 1px solid #f0f2f5;
  display: flex;
  align-items: center;
  gap: 10px;
}
.why-card-home li:last-child {
  border-bottom: none;
}
.why-card-home li i {
  color: var(--green);
  width: 18px;
}

/* ===================== ABOUT CARDS ===================== */
.about-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
  gap: 22px;
  margin-top: 40px;
}
.info-card {
  background: var(--gray);
  border-radius: var(--radius);
  padding: 28px 22px;
  border: 1px solid #e8ecf0;
  transition: transform 0.3s, box-shadow 0.3s;
}
.info-card:hover {
  transform: translateY(-6px);
  box-shadow: var(--shadow);
}
.info-card .card-icon {
  font-size: 2rem;
  margin-bottom: 12px;
}
.info-card h3 {
  font-size: 1.05rem;
  color: var(--blue);
  margin-bottom: 8px;
}
.info-card p {
  font-size: 0.88rem;
  color: var(--text-soft);
  line-height: 1.65;
}
.section-wrap {
  padding: 90px 20px;   /* add side spacing properly */
}


/* ===================== CHOOSE US ===================== */
.choose-section {
  padding: 90px 0;
  background: var(--green);
}
.choose-section .section-title {
  color: white;
}
.choose-section .section-tag {
  background: rgba(255,255,255,0.15);
  color: rgba(255,255,255,0.9);
}
.choose-section .section-sub {
  color: rgba(255,255,255,0.75);
}
.choose-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
  gap: 20px;
  margin-top: 40px;
}
.choose-card {
  background: rgba(255,255,255,0.10);
  border: 1px solid rgba(255,255,255,0.20);
  border-radius: var(--radius);
  padding: 26px 22px;
  color: white;
  transition: background 0.3s, transform 0.3s;
}
.choose-card:hover {
  background: rgba(255,255,255,0.17);
  transform: translateY(-5px);
}
.choose-card .cicon {
  font-size: 2rem;
  margin-bottom: 12px;
}
.choose-card h3 {
  font-size: 1.03rem;
  margin-bottom: 8px;
}
.choose-card p {
  font-size: 0.87rem;
  color: rgba(255,255,255,0.77);
  line-height: 1.55;
}

/* ===================== DOCTOR CARDS ===================== */
.doctor-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 26px;
  margin-top: 40px;
}
.doctor-card {
  background: white;
  border-radius: var(--radius);
  padding: 30px 22px;
  text-align: center;
  box-shadow: var(--shadow);
  transition: transform 0.35s, box-shadow 0.35s;
  cursor: pointer;
}
.doctor-card:hover {
  transform: translateY(-10px);
  box-shadow: var(--shadow-lg);
}
.doctor-card img {
  width: 110px;
  height: 110px;
  border-radius: 50%;
  object-fit: cover;
  border: 4px solid var(--green-pale);
  margin-bottom: 14px;
}
.doctor-card h4 {
  font-size: 1.05rem;
  color: var(--blue);
  margin-bottom: 5px;
}
.dept-badge {
  display: inline-block;
  background: var(--green-pale);
  color: var(--green);
  font-size: 0.77rem;
  font-weight: 600;
  padding: 3px 12px;
  border-radius: 12px;
  margin-bottom: 10px;
}
.about-doc {
  font-size: 0.84rem;
  color: var(--text-soft);
  line-height: 1.6;
  margin-bottom: 10px;
}
.fee-label {
  font-size: 0.9rem;
  font-weight: 600;
  color: var(--green);
  margin-bottom: 14px;
}
.book-btn {
  display: inline-block;
  padding: 9px 22px;
  background: var(--green);
  color: white;
  border-radius: 22px;
  font-size: 0.86rem;
  font-weight: 600;
  transition: background 0.2s, transform 0.2s;
}
.book-btn:hover {
  background: var(--green-light);
  transform: scale(1.05);
  color: white;
}

/* ===================== SERVICE CARDS ===================== */
.services-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(235px, 1fr));
  gap: 24px;
  margin-top: 40px;
}
.ser {
  background: var(--gray);
  border-radius: var(--radius);
  overflow: hidden;
  box-shadow: 0 4px 16px rgba(0,0,0,0.07);
  transition: transform 0.35s, box-shadow 0.35s;
  cursor: pointer;
  opacity: 0;
  transform: translateY(36px);
}
.ser.visible {
  opacity: 1;
  transform: translateY(0);
  transition: opacity 0.7s ease, transform 0.7s ease;
}
.ser:hover {
  transform: translateY(-8px);
  box-shadow: var(--shadow-lg);
}
.ser img {
  width: 100%;
  height: 160px;
  object-fit: cover;
  display: block;
}
.ser-body {
  padding: 18px 20px;
}
.ser h4 {
  font-size: 1rem;
  color: var(--blue);
  margin-bottom: 6px;
}
.ser p {
  font-size: 0.86rem;
  color: var(--text-soft);
  line-height: 1.6;
}

/* ===================== GALLERY ===================== */
.gallery-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 18px;
  margin-top: 36px;
}
.gallery-img {
  width: 100%;
  height: 180px;
  object-fit: cover;
  border-radius: 12px;
  box-shadow: 0 4px 14px rgba(0,0,0,0.12);
  display: block;
  transition: transform 0.3s, box-shadow 0.3s;
}
.gallery-img:hover {
  transform: scale(1.04);
  box-shadow: 0 10px 28px rgba(0,0,0,0.22);
}
.video-box {
  margin-top: 40px;
  text-align: center;
}
.video-box h3 {
  font-size: 1.3rem;
  color: var(--blue);
  margin-bottom: 16px;
}
.video-box video {
  border-radius: 14px;
  max-width: 100%;
  width: 560px;
  box-shadow: var(--shadow);
}

/* ===================== REVIEW + SUBSCRIBE ===================== */
.review-sub-section {
  padding: 90px 0;
  background: linear-gradient(135deg, #0d6e4f 0%, #0a3c66 100%);
}
.review-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 40px;
  align-items: center;
}
.review-card-box {
  background: rgba(255,255,255,0.10);
  border: 1px solid rgba(255,255,255,0.20);
  border-radius: var(--radius);
  padding: 32px;
}
.review-card-box p {
  font-size: 1.05rem;
  line-height: 1.75;
  color: rgba(255,255,255,0.9);
  margin-bottom: 16px;
  font-style: italic;
}
.review-card-box span {
  font-size: 0.88rem;
  color: rgba(255,255,255,0.62);
}
.subscribe-block h2 {
  font-size: 1.8rem;
  color: white;
  margin-bottom: 10px;
}
.subscribe-block p {
  color: rgba(255,255,255,0.75);
  margin-bottom: 22px;
}
.subscribe-row {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}
.subscribe-row input {
  flex: 1;
  min-width: 200px;
  padding: 12px 18px;
  border-radius: 30px;
  border: none;
  font-size: 0.95rem;
  outline: none;
  font-family: 'DM Sans', sans-serif;
}
.subscribe-row button {
  background: var(--accent);
  color: #1a1a1a;
  border: none;
  padding: 12px 26px;
  border-radius: 30px;
  font-size: 0.95rem;
  font-weight: 700;
  cursor: pointer;
  font-family: 'DM Sans', sans-serif;
  transition: background 0.2s;
}
.subscribe-row button:hover {
  background: #e09510;
}
#subMsg {
  color: #a8e6c8;
  margin-top: 10px;
  font-size: 0.9rem;
  display: none;
}

/* ===================== CONTACT ===================== */
.contact-cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 22px;
  margin-top: 40px;
  margin-bottom: 40px;
}
.contact-card {
  background: var(--gray);
  border-radius: var(--radius);
  padding: 28px 24px;
  border: 1px solid #e8ecf0;
  transition: box-shadow 0.3s;
}
.contact-card:hover {
  box-shadow: var(--shadow);
}
.cicon {
  width: 52px;
  height: 52px;
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.35rem;
  margin-bottom: 16px;
}
.cicon.phone {
  background: #eef4ff;
  color: #2d5be3;
}
.cicon.email {
  background: #fff7e6;
  color: #e07800;
}
.cicon.intl {
  background: #f0fff4;
  color: var(--green);
}
.contact-card h4 {
  font-size: 0.76rem;
  color: var(--text-soft);
  text-transform: uppercase;
  letter-spacing: 1px;
  margin-bottom: 5px;
  font-family: 'DM Sans', sans-serif;
  font-weight: 700;
}
.contact-card .val {
  font-size: 0.93rem;
  color: var(--blue);
  font-weight: 600;
  margin-bottom: 14px;
  word-break: break-all;
}

/* Section */
/* GLOBAL FIX */
* {
  box-sizing: border-box;
}

html, body {
  margin: 0;
  padding: 0;
  width: 100%;
  font-family: Arial, sans-serif;
}
section {
  width: 100%;
  margin: 0;
}
.section-wrap {
  padding: 90px 20px;   /* add inside spacing properly */
}

/* ===================== CONTACT ===================== */
#contact-sec {
  width: 100%;
  padding: 50px 0;   /* ❗ removed side gap */
 
}

.contact-title {
  text-align: center;
  font-size: 32px;
  margin-bottom: 30px;
  color: #2d3748;
}

/* FULL WIDTH FORM */
.contact-form {
  width: 100%;
  padding: 0 20px;   /* reduce side space */
}

/* Row */
.contact-row {
  display: flex;
  gap: 20px;
  margin-bottom: 20px;
}

/* Inputs */
.contact-form input,
.contact-form textarea {
  width: 100%;
  padding: 16px;
  border-radius: 12px;
  border: 1px solid #cbd5e0;
  font-size: 15px;

  outline: none;
}

/* Focus */
.contact-form input:focus,
.contact-form textarea:focus {
  border-color: #3182ce;
  box-shadow: 0 0 0 2px rgba(49,130,206,0.2);
}

#cSubject {
  margin-bottom: 20px;
}

.contact-form textarea {
  height: 180px;
  resize: none;
  margin-bottom: 20px;
}

/* Button */
.contact-btn {
  width: 100%;
  padding: 16px;
  background: #2f6fd6;
  color: white;
  border: none;
  border-radius: 14px;
  font-size: 18px;
  cursor: pointer;
}

.contact-btn:hover {
  background: #1e4fa3;
}

#cMsg {
  margin-top: 15px;
  text-align: center;
  color: green;
  font-weight: bold;
  display: none;
}

/* ===================== BOOK FORM ===================== */
#book {
  width: 100%;
  min-height: 100vh;

  background: url("https://static.vecteezy.com/system/resources/previews/029/284/412/original/healthcare-theme-3d-illustration-of-an-empty-emergency-room-ai-generative-free-photo.jpg") no-repeat center center;
  background-size: cover;

  padding: 40px 0;
}

/* Center form ONLY (this is correct) */
.form-box {
  max-width: 500px;
  margin: auto;
  background: #f7f9fc;
  padding: 30px;
  border-radius: 12px;
}

/* Inputs */
form input,
form select,
form textarea {
  width: 100%;
  padding: 14px;
  border: 1px solid #cbd5e0;
  border-radius: 10px;
}

/* Button */
.btn {
  width: 100%;
  margin-top: 20px;
  padding: 15px;
  background: #167a5c;
  color: #fff;
  border: none;
  border-radius: 30px;
  cursor: pointer;
}

.btn:hover {
  background: #125f48;
}

#msg {
  margin-top: 15px;
  color: green;
  font-weight: bold;
  display: none;
}

/* ===================== COLLAB ===================== */
.collaboration {
  width: 100vw;   /* 🔥 full screen */
  margin-left: calc(-50vw + 50%);  /* 🔥 remove side gap */
  background: black;
  color: white;
  padding: 80px 0;
  text-align: center;
}

.logo-track {
  display: flex;
  gap: 40px;
  animation: logoslide 22s linear infinite;
  width: max-content;
}

.logo-track img {
  width: 140px;
  height: 90px;
  background: white;
  padding: 14px;
  border-radius: 10px;
}

@keyframes logoslide {
  from { transform: translateX(0); }
  to   { transform: translateX(-50%); }
}

/* ===================== FOOTER ===================== */
.footer {
  background: pink;
  width: 100vw;        /* 🔥 FULL SCREEN WIDTH */
  margin-left: calc(-50vw + 50%); /* 🔥 remove side gap */
  padding: 50px 0;
}

.foot-container {
  width: 100%;
  padding: 0 40px;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 30px;
}

.foot-box h2,
.foot-box h3 {
  color: #000;
}

.foot-box p {
  color: #444;
}

.foot-box a {
  color: #555;
  text-decoration: none;
}

.foot-bottom {
  border-top: 1px solid #ddd;
  margin: 30px 40px 0;
  padding-top: 20px;
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
}

/* Scroll button */
.scroll-btn {
  position: fixed;
  bottom: 20px;
  left: 20px;
  background: #2f6fd6;
  color: #fff;
  border: none;
  padding: 12px;
  border-radius: 50%;
}

/* ===================== RESPONSIVE ===================== */
@media (max-width: 992px) {
  .home-grid   { grid-template-columns: 1fr; }
  .review-grid { grid-template-columns: 1fr; }
  .stat-item   { flex: 1 1 50%; }
}

@media (max-width: 768px) {
  .nav-links      { display: none; }
  .hamburger-btn  { display: block; }
  .hero-content   { padding: 0 24px 100px; }
  .stats-bar      { position: relative; }
  .hero           { height: auto; min-height: 100vh; }
  .form-box       { padding: 24px 18px; }
  .form-row-2     { flex-direction: column; gap: 0; }
  .section-wrap   { padding: 64px 0; }
  .choose-section { padding: 64px 0; }
  .review-sub-section { padding: 64px 0; }
  .collaboration  { padding: 60px 0; }
}

@media (max-width: 480px) {
  .hero-buttons  { flex-direction: column; align-items: flex-start; }
  .stat-item     {
    flex: 1 1 100%;
    border-right: none;
    border-bottom: 1px solid #e5e7eb;
  }
  .navbar-custom { padding: 0 16px; }
  .navbar-brand-text { font-size: 1.05rem; }
}
/* ===================== CSS VARIABLES ===================== */
:root {
  --green:       #0d6e4f;
  --green-light: #1a8a62;
  --green-pale:  #e8f5f0;
  --blue:        #0a3c66;
  --accent:      #f5a623;
  --pink:        #8b1b5e;
  --white:       #ffffff;
  --gray:        #f6f8fb;
  --text:        #1e293b;
  --text-soft:   #64748b;
  --radius:      16px;
  --shadow:      0 8px 32px rgba(0,0,0,0.10);
  --shadow-lg:   0 16px 48px rgba(0,0,0,0.16);
}
